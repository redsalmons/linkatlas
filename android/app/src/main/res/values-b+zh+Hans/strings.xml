    <!-- Privacy page -->
    <string name="privacy_title">隐私与数据</string>
    <string name="privacy_intro">连接观察全部在你的手机里完成。联网仅用于设备注册、服务解读、购买验证和白名单下载。</string>
    <string name="privacy_collect_title">记录什么</string>
    <string name="privacy_collect_body">目标 IP、端口、域名、上下行字节数、连接时间。</string>
    <string name="privacy_not_collect_title">不记录什么</string>
    <string name="privacy_not_collect_body">聊天内容、账号、密码、图片、文件、浏览记录。</string>
    <string name="privacy_storage_title">保存在哪里</string>
    <string name="privacy_storage_body">只在本次会话的内存里，不写入磁盘。关闭 VPN 或点「清空记录」即释放。</string>
    <string name="privacy_transfer_title">联网与上传</string>
    <string name="privacy_transfer_body">本机连接记录永不上传。联网只发生在这几种情况：
① 设备注册——首次使用联网功能时发送平台、应用版本和设备公钥，经 App Attest（iOS）/ Play Integrity（Android）验证真实性，仅用于签发访问凭证；
② 服务解读——把你选择的那一个域名或 IP 发送给查询服务器，由服务器转交 AI 模型分析；
③ 购买验证——购买凭证发送给查询服务器核验额度；
④ 白名单——启动时从服务器下载过滤规则。
这些请求都不会携带你的连接记录。</string>
    <string name="privacy_third_party_title">第三方 SDK</string>
    <string name="privacy_third_party_body">无统计、无广告、无埋点。IP 归属地使用随安装包内置的离线数据库；服务解读由 AI 模型生成，模型只会收到你查询的那一个地址。</string>
    <string name="privacy_location_title">位置权限</string>
    <string name="privacy_location_body">只有大致位置，仅用于在地图上标出你的起点，不保存、不上传。可随时在系统设置中关闭。</string>
    <string name="privacy_vpn_title">VPN 权限</string>
    <string name="privacy_vpn_body">系统只允许通过 VPN 接口读取连接信息，这是本应用申请它的唯一用途：流量原样转发，不做拦截、不改内容。</string>
    <string name="privacy_policy_link">查看完整隐私政策</string>
    <string name="privacy_clear">清空记录</string>
    <string name="privacy_clear_confirm_title">清空本次会话记录？</string>
    <string name="privacy_clear_confirm_body">将删除当前会话的全部连接记录，无法恢复。VPN 保持连接。</string>
    <string name="privacy_cleared">已清空</string>
