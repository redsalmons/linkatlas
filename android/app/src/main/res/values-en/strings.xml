    <!-- Privacy page -->
    <string name="privacy_title">Privacy &amp; data</string>
    <string name="privacy_intro">All connection analysis happens on your phone. The app goes online only for device registration, Service insight, purchase verification, and whitelist downloads.</string>
    <string name="privacy_collect_title">What we record</string>
    <string name="privacy_collect_body">Destination IPs, ports, domains, per-connection byte counts, and timestamps.</string>
    <string name="privacy_not_collect_title">What we don’t record</string>
    <string name="privacy_not_collect_body">Message content, accounts, passwords, images, files, or browsing history.</string>
    <string name="privacy_storage_title">Where it’s stored</string>
    <string name="privacy_storage_body">Only in memory for this session — never written to disk. Stopping the VPN or tapping “Clear records” frees it.</string>
    <string name="privacy_transfer_title">Network access</string>
    <string name="privacy_transfer_body">Local connection records are never uploaded. The app only goes online in these cases:
(1) Device registration — on first use of an online feature the app sends the platform, app version, and a device public key, verified by App Attest (iOS) / Play Integrity (Android), used only to issue access credentials;
(2) Service insight — the single domain or IP you choose is sent to our lookup server, which forwards it to an AI model for analysis;
(3) purchase verification — receipts are sent to the server to verify your entitlement;
(4) whitelist — filter rules are downloaded at launch.
None of these requests carries your connection history.</string>
    <string name="privacy_third_party_title">Third-party SDKs</string>
    <string name="privacy_third_party_body">No analytics, ads, or tracking. IP geolocation uses an offline database bundled in the app. Service insight is produced by an AI model that only receives the single address you queried.</string>
    <string name="privacy_location_title">Location permission</string>
    <string name="privacy_location_body">Approximate location only, used solely to mark your starting point on the map. Never saved or uploaded; you can revoke it in system settings anytime.</string>
    <string name="privacy_vpn_title">VPN permission</string>
    <string name="privacy_vpn_body">The VPN interface is the only way the system lets an app see connection metadata — its sole purpose here. Traffic is forwarded unchanged: no blocking, no modification.</string>
    <string name="privacy_policy_link">Read the full privacy policy</string>
    <string name="privacy_clear">Clear records</string>
    <string name="privacy_clear_confirm_title">Clear this session’s records?</string>
    <string name="privacy_clear_confirm_body">All connection records of the current session will be deleted and cannot be recovered. The VPN stays connected.</string>
